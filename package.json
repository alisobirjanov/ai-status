{
  "name": "pulse-windows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && tsc --noEmit",
    "tauri": "tauri",
    "app": "node scripts/dev-app.mjs",
    "app:start": "node scripts/dev-app.mjs start",
    "app:stop": "node scripts/dev-app.mjs stop",
    "app:dev": "tauri dev --config src-tauri/tauri.dev.conf.json"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
